# AFRC Application & Server Settings
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./afrc.db

# Domain & Caddy SSL Configuration (Auto-Configured)
# Leave empty for direct IP:PORT access.
# If configured, Caddy will automatically provision SSL certificates and route traffic to port 8000.
# Multiple domains can be comma-separated, e.g. takcakap.com, demo.takcakap.com
DOMAIN=

# Google OAuth / Google Identity Services (Customer Account & Loyalty)
# Web Client ID used for both frontend Sign-In with Google and backend ID token verification
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
CUSTOMER_SESSION_SECRET=
