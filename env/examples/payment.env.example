# Payment Gateway Configuration (AFRC = Curlec, Self-Service = CHIP)
# Copy this file to env/payment.env and fill in your keys.

# --- Curlec (Razorpay Malaysia) for AFRC AI Checkout ---
CURLEC_KEY_ID=
CURLEC_KEY_SECRET=
CURLEC_WEBHOOK_SECRET=

# --- CHIP (chip-in.asia) for /selfservice Checkout ---
CHIP_BRAND_ID=
CHIP_SECRET_KEY=
CHIP_WEBHOOK_SECRET=
